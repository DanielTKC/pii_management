# ============================================================================
# PII MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION
# ============================================================================
#
# ⚠️  IMPORTANT NOTICE:
#
# This .env.example contains ACTUAL WORKING VALUES for demo/development purposes.
# These are NOT real production secrets - this is a code challenge demonstration.
#
# For a production deployment, you would:
# 1. Generate NEW secrets for each environment
# 2. Store them in a secret management service (AWS Secrets Manager, etc.)
# 3. NEVER commit actual production secrets to version control OR post them to a github
#
# For this demo, simply copy this file to .env to get started:
#   cp .env.example .env
#   docker compose up
#
# ============================================================================

# Database Configuration
POSTGRES_DB=pii_management_development
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Rails Configuration
RAILS_ENV=development

# Rails Master Key (decrypts config/credentials.yml.enc)
# ⚠️  DEMO VALUE - In production, generate a new one and keep it secret!
# This key unlocks the encrypted credentials file which contains the JWT secret
RAILS_MASTER_KEY=2234ab7dcd066fdf66747009679ae8ad

# Java Service Configuration
JAVA_SERVICE_URL=http://java-service:8080
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Encryption Configuration (AES-256-GCM for SSN encryption)
# ⚠️  DEMO VALUE - In production, generate a new one with: openssl rand -base64 32
# This is a 32-byte (256-bit) key encoded in Base64
ENCRYPTION_KEY=BtX1mBZ+rXQWdlVwXdHiiKtyHuPPz6PVrPajX4ma+B8=

# React Frontend Configuration
# Leave empty to use Vite proxy in development (recommended)
# Set to your API URL in production (e.g., https://api.example.com)
VITE_API_URL=

# Security Configuration
# Rate limiting (requests per minute)
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_PERIOD=60

# Session Configuration
# ⚠️  DEMO VALUE - In production, generate with: docker compose exec rails-api bundle exec rails secret
SECRET_KEY_BASE=your_secret_key_base_here

# Audit Logging
ENABLE_AUDIT_LOG=true
AUDIT_LOG_LEVEL=info

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Java Service Timeout Configuration
JAVA_SERVICE_TIMEOUT=5
JAVA_SERVICE_RETRIES=3

# ============================================================================
# QUICK START
# ============================================================================
#
# To get the application running:
#
# 1. Copy this file to .env:
#    cp .env.example .env
#
# 2. Start all services:
#    docker compose up
#
# 3. Access the application:
#    - React Frontend: http://localhost:5173
#    - Rails API: http://localhost:3000
#    - Java Service: http://localhost:8080
#
# That's it! The demo values above will work out of the box.
#
# ============================================================================

# ============================================================================
# PRODUCTION DEPLOYMENT CHECKLIST
# ============================================================================
#
# When deploying to production, you MUST:
#
# 1. Generate NEW secrets (do not use the demo values above):
#    - RAILS_MASTER_KEY: rails credentials:edit (creates new key)
#    - ENCRYPTION_KEY: openssl rand -base64 32
#    - SECRET_KEY_BASE: rails secret
#
# 2. Store secrets securely:
#    - AWS Secrets Manager
#    - Google Cloud Secret Manager
#    - HashiCorp Vault
#    - Azure Key Vault
#    - DO NOT store in .env file in production
#
# 3. Update these settings:
#    RAILS_ENV=production
#    DATABASE_URL=postgresql://user:password@host:5432/pii_management_production
#    VITE_API_URL=https://api.yourapp.com
#    CORS_ALLOWED_ORIGINS=https://yourapp.com,https://www.yourapp.com
#
# 4. Enable additional security:
#    - TLS/HTTPS certificates
#    - Rate limiting (configure Rack::Attack)
#    - Database encryption at rest
#    - Regular key rotation
#    - Web Application Firewall (WAF)
#
# ============================================================================

# ============================================================================
# UNDERSTANDING THE SECRETS
# ============================================================================
#
# RAILS_MASTER_KEY:
#   - Decrypts config/credentials.yml.enc
#   - The credentials file contains the JWT secret
#   - This is a Rails 8 best practice for secret management
#   - In this demo: allows immediate docker compose up
#   - In production: store in secrets manager, not in .env
#
# ENCRYPTION_KEY:
#   - Used by Java service for AES-256-GCM encryption
#   - Encrypts SSN data before storing in database
#   - Must be 32 bytes (256 bits), Base64-encoded
#   - Should be rotated periodically in production
#
# JWT Secret (stored in credentials.yml.enc):
#   - Used to sign JSON Web Tokens for authentication
#   - Not directly in .env, accessed via Rails.application.credentials.jwt_secret
#   - Encrypted at rest using RAILS_MASTER_KEY
#
# ============================================================================
